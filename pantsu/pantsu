#!/usr/bin/env python3
"""pantsu —— YojigenOS 系统构建驱动

skirt 建包；pantsu 建系统。

用法:
    pantsu/pantsu flavors                       列出所有风味（顺带校验每一个）
    pantsu/pantsu flavor <名>                   看一个风味里有什么
    pantsu/pantsu rootfs <名>                   从 apk 仓库装出一个根（并打 tar）
    pantsu/pantsu rootfs <名> --probe           装完顺手在容器里验一遍
    pantsu/pantsu rootfs <名> --arch x86_64     指定架构（默认宿主架构）

    pantsu/pantsu rootfs <名> --repo http://host.docker.internal:18080
                                                用宿主上的本地仓库（调试用）

它和 packages 的关系:
    ★ 只有一样东西：一个 apk 仓库 URL。

    不 checkout 配方、不读 var/output/、不 import skirtlib。理由见 README，
    最要命的那条是：**它让「发布的包」和「用来组装的包」可以是不同的东西，
    而且没人会发现**。只认仓库 URL，这个问题就不存在——因为只有一个来源。

分工（2026-10-12 定）:
    能成为一个 apk 包的        → packages（配方、构建、打包、发布）
    构建我们的系统才需要的      → 这里（风味、组装、交付物）

这个文件只是入口。实现在 pantsulib/ 里按职责分开：
    common.py   路径常量、日志、命令执行
    flavor.py   风味定义（variants/*.toml）的读取与校验
    root.py     从 apk 仓库装出一个根，打成 tar

还没有的（下一刀）:
    vm.py       起 QEMU（现在还在 scripts/run-vm.sh 里，而且还在调 packages 的 skirt）
    image.py    容器交付物（现在还在 scripts/assemble.sh 里）
    img.py      磁盘交付物 —— 0013 定的那条路，一张自带一切的 .img
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

# 允许直接以脚本方式运行（./pantsu/pantsu），无需安装
sys.path.insert(0, str(Path(__file__).resolve().parent))

from pantsulib import flavor, root
from pantsulib.common import DEFAULT_REPO, LOCAL_REPO


def main() -> None:
    p = argparse.ArgumentParser(
        prog="pantsu", description="YojigenOS 系统构建驱动")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("flavors", help="列出所有风味")

    q = sub.add_parser("flavor", help="看一个风味")
    q.add_argument("name")

    r = sub.add_parser("rootfs", help="从 apk 仓库装出一个根（并打 tar）")
    r.add_argument("name")
    r.add_argument("--arch", help="默认宿主架构")
    r.add_argument("--repo", default=DEFAULT_REPO,
                   help=f"apk 仓库 URL（默认 {DEFAULT_REPO}；本地调试用 {LOCAL_REPO}）")
    r.add_argument("--probe", action="store_true",
                   help="装完导入成临时镜像，跑一遍 scripts/verify-in-image.sh")
    r.add_argument("--skip-missing", action="store_true",
                   help="过渡期用：仓库里还没有的包跳过，并大声报出来")

    a = p.parse_args()

    if a.cmd == "flavors":
        flavor.listing()
    elif a.cmd == "flavor":
        flavor.show(a.name)
    elif a.cmd == "rootfs":
        root.build(a.name, a.arch, a.repo,
                   probe=a.probe, skip_missing=a.skip_missing)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        # 输出被下游截断（例如 `pantsu flavors | head`）。不是错误。
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
