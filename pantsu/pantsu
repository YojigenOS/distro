#!/usr/bin/env python3
"""pantsu —— YojigenOS 系统构建驱动

skirt 建包；pantsu 建系统。

用法:
    pantsu/pantsu flavors                       列出所有风味（顺带校验每一个）
    pantsu/pantsu flavor <名>                   看一个风味里有什么
    pantsu/pantsu rootfs <名>                   从 apk 仓库装出一个根（并打 tar）
    pantsu/pantsu rootfs <名> --probe           装完顺手在容器里验一遍
    pantsu/pantsu rootfs <名> --arch x86_64     指定架构（默认宿主架构）
    pantsu/pantsu img <名>                      把根变成一张能 DD 的磁盘镜像
                                                （混合 GPT + 引导器 + grub.cfg + .zst）
    pantsu/pantsu img <名> --publish            顺带准备发布（干跑，只列要传什么）
    pantsu/pantsu img <名> --publish --go       真的传到 repo.os.yojigen.cn
    pantsu/pantsu publish <名>                  把已建好的镜像放进仓库（干跑）
    pantsu/pantsu publish <名> --go             同上，真传（CI 里就是这么用的）
    pantsu/pantsu verify <镜像>                 验一个容器镜像：元数据 + 在镜像里跑一遍
    pantsu/pantsu verify <镜像> --flavor base   顺带核对风味标签（对不对得上）
    pantsu/pantsu vm <名>                       在 QEMU 里跑起来（默认启磁盘镜像）
    pantsu/pantsu vm <名> --mode direct         内核 + initramfs 直启（改完用户态马上看）

    pantsu/pantsu rootfs <名> --repo http://host.docker.internal:18080
                                                用宿主上的本地仓库（调试用）

它和 packages 的关系:
    ★ 只有一样东西：一个 apk 仓库 URL。

    不 checkout 配方、不读 var/output/、不 import skirtlib。理由见 README，
    最要命的那条是：**它让「发布的包」和「用来组装的包」可以是不同的东西，
    而且没人会发现**。只认仓库 URL，这个问题就不存在——因为只有一个来源。

分工（2026-10-12 定）:
    能成为一个 apk 包的        → packages（配方、构建、打包、发布）
    构建我们的系统才需要的      → 这里（风味、组装、交付物）

这个文件只是入口。实现在 pantsulib/ 里按职责分开：
    common.py   路径常量、日志、命令执行
    flavor.py   风味定义（variants/*.toml）的读取与校验
    root.py     从 apk 仓库装出一个根，打成 tar
    img.py      把根变成磁盘镜像（0013 那条路：混合 GPT + 引导器）
    repo.py     把镜像放进仓库（repo.os.yojigen.cn，rclone）
    vm.py       在 QEMU 里跑起来（启镜像 / 内核直启）
    verify.py   验交付物（镜像里跑一遍；那段 payload 和 rootfs --probe 共用）
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

# 允许直接以脚本方式运行（./pantsu/pantsu），无需安装
sys.path.insert(0, str(Path(__file__).resolve().parent))

from pantsulib import flavor, img, repo, root, verify, vm
from pantsulib.common import DEFAULT_REPO, LOCAL_REPO, VAR_DIR, resolve_arch


def main() -> None:
    p = argparse.ArgumentParser(
        prog="pantsu", description="YojigenOS 系统构建驱动")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("flavors", help="列出所有风味")

    q = sub.add_parser("flavor", help="看一个风味")
    q.add_argument("name")

    r = sub.add_parser("rootfs", help="从 apk 仓库装出一个根（并打 tar）")
    r.add_argument("name")
    r.add_argument("--arch", help="默认宿主架构")
    r.add_argument("--repo", default=DEFAULT_REPO,
                   help=f"apk 仓库 URL（默认 {DEFAULT_REPO}；本地调试用 {LOCAL_REPO}）")
    r.add_argument("--probe", action="store_true",
                   help="装完导入成临时镜像，跑一遍 verify.IN_IMAGE_SCRIPT（和 pantsu verify 同一条）")
    r.add_argument("--skip-missing", action="store_true",
                   help="过渡期用：仓库里还没有的包跳过，并大声报出来")

    g = sub.add_parser("img", help="把装好的根变成磁盘镜像（混合 GPT + 引导器）")
    g.add_argument("name")
    g.add_argument("--arch", help="默认宿主架构")
    g.add_argument("--repo", default=DEFAULT_REPO, help="只在提示里用（根要先装好）")
    g.add_argument("--out", help="输出路径（默认 var/<风味>/<风味>-<架构>.img）")
    g.add_argument("--size", default="1G", help="镜像虚拟大小（默认 1G）")
    g.add_argument("--kernel", help="根里 /boot 下的内核文件名（默认 vmlinuz）")
    g.add_argument("--publish", action="store_true",
                   help="建完顺带准备发布（默认干跑，只列要传什么）")
    g.add_argument("--go", action="store_true",
                   help="配合 --publish：真的传（和 packages 的 deploy.sh 同一个约定）")

    pb = sub.add_parser("publish", help="把已建好的镜像放进仓库（默认干跑）")
    pb.add_argument("name")
    pb.add_argument("--arch", help="默认宿主架构")
    pb.add_argument("--img", help="指定镜像文件（默认 var/<风味>/<风味>-<架构>.img.zst）")
    pb.add_argument("--go", action="store_true", help="真的传（不加就只列要传什么）")

    v = sub.add_parser("verify", help="验一个容器镜像（元数据 + 在镜像里跑一遍）")
    v.add_argument("image", help="镜像名，例如 yojigenos/base:edge")
    v.add_argument("--flavor", help="顺便核对风味标签：对不上说明传错镜像了")

    m = sub.add_parser("vm", help="在 QEMU 里把它跑起来（镜像或直启）")
    m.add_argument("name")
    m.add_argument("--arch", help="默认宿主架构")
    m.add_argument("--img", help="指定镜像文件（默认 var/<风味>/<风味>-<架构>.img）")
    m.add_argument("--mem", default="1G")
    m.add_argument("--mode", choices=["auto", "disk", "direct"], default="auto",
                   help="auto：有镜像就启镜像，否则内核直启")
    m.add_argument("--no-accel", action="store_true", help="强制关掉 hvf（跨架构本来就会关）")
    m.add_argument("--firmware", help="aarch64 的 UEFI 固件路径（x86_64 用 QEMU 自带 SeaBIOS）")
    m.add_argument("--serial-file", help="串口写文件、不要图形——给脚本和 CI 用")
    m.add_argument("--timeout", type=int, help="跑 N 秒就收工（配合 --serial-file 用）")
    m.add_argument("--expect", action="append", help="串口里出现这句话就算起来了（CI 的断言；可以给多次，全部出现才算过；"
                                    "同时会因为 Kernel panic 立刻失败）")

    a = p.parse_args()

    if a.cmd == "flavors":
        flavor.listing()
    elif a.cmd == "flavor":
        flavor.show(a.name)
    elif a.cmd == "rootfs":
        root.build(a.name, a.arch, a.repo,
                   probe=a.probe, skip_missing=a.skip_missing)
    elif a.cmd == "img":
        zst = img.build(a.name, a.arch, a.repo,
                        out=a.out, size=a.size, kernel=a.kernel)
        if a.publish:
            repo.publish(zst, a.name, resolve_arch(a.arch), go=a.go)
    elif a.cmd == "verify":
        verify.verify(a.image, a.flavor)
    elif a.cmd == "publish":
        arch = resolve_arch(a.arch)
        zst = Path(a.img) if a.img else (VAR_DIR / a.name / f"{a.name}-{arch}.img.zst")
        repo.publish(zst, a.name, arch, go=a.go)
    elif a.cmd == "vm":
        sys.exit(vm.run(a.name, a.arch, img=a.img, mem=a.mem, mode=a.mode,
                        accel=False if a.no_accel else None,
                        firmware=a.firmware, serial_file=a.serial_file,
                        timeout=a.timeout, expect=a.expect))


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        # 输出被下游截断（例如 `pantsu flavors | head`）。不是错误。
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
